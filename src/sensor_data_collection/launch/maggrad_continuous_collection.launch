<launch>
  <!--
    MagGrad continuous collection:

    Start:
      roslaunch sensor_data_collection maggrad_continuous_collection.launch

    Start with live image viewer:
      roslaunch sensor_data_collection maggrad_continuous_collection.launch show_image:=true

    Start recording:
      rostopic pub /maggrad_continuous_collection/record_trigger std_msgs/Bool "data: true" -1

    Stop recording:
      rostopic pub /maggrad_continuous_collection/record_trigger std_msgs/Bool "data: false" -1

    Output:
      $(arg output_dir)/maggrad_continuous_*.csv
  -->

  <arg name="port" default="runtime"/>
  <arg name="baudrate" default="runtime"/>
  <arg name="hardware_config" default="runtime"/>
  <arg name="output_dir" default="$(find sensor_data_collection)/../../data"/>
  <arg name="startup_strategy" default="runtime"/>
  <arg name="startup_sensors" default="runtime"/>
  <arg name="startup_profile" default="runtime"/>
  <arg name="icm_rate_hz" default="runtime"/>
  <arg name="trigger_rate_hz" default="runtime"/>
  <arg name="n_sensors" default="runtime"/>
  <arg name="collection_config" default="$(find sensor_data_collection)/config/maggrad_continuous_collection.yaml"/>
  <arg name="signal_config" default="$(find sensor_data_collection)/config/signal_params_maggrad_continuous.yaml"/>
  <arg name="record_tf" default="true"/>
  <arg name="tf_reference_frame" default="lab_table"/>
  <arg name="show_image" default="false"/>
  <arg name="experiment_id" default=""/>
  <arg name="sensor_type" default=""/>
  <arg name="board" default=""/>
  <arg name="profile" default="$(arg startup_profile)"/>
  <arg name="mag_rate_hz" default="$(arg trigger_rate_hz)"/>
  <arg name="coil_current_a" default=""/>
  <arg name="rotation_run_id" default=""/>
  <arg name="firmware_status" default=""/>
  <arg name="warning" default="NONE"/>
  <arg name="ak_bitmap" default=""/>
  <arg name="ak_count" default=""/>

  <include file="$(find zlab_robots_calibration)/launch/localization_tagslam.launch"/>

  <node if="$(arg show_image)" name="maggrad_image_view" pkg="rqt_image_view"
        type="rqt_image_view" output="screen"/>

  <node name="fy8300" pkg="signal_generator" type="fy8300_node" output="screen">
    <rosparam command="load" file="$(arg signal_config)"/>
  </node>

  <node name="serial_node_maggrad" pkg="serial_processor" type="serial_node_maggrad.py" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baudrate" value="$(arg baudrate)"/>
    <param name="hardware_config" value="$(arg hardware_config)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="startup_strategy" value="$(arg startup_strategy)"/>
    <param name="startup_sensors" value="$(arg startup_sensors)"/>
    <param name="profile" value="$(arg startup_profile)"/>
    <param name="icm_rate_hz" value="$(arg icm_rate_hz)"/>
    <param name="trigger_rate_hz" value="$(arg trigger_rate_hz)"/>
  </node>

  <node name="maggrad_continuous_collection" pkg="sensor_data_collection"
        type="maggrad_continuous_collection_node.py" output="screen">
    <rosparam file="$(arg collection_config)" command="load"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="hardware_config" value="$(arg hardware_config)"/>
    <param name="n_sensors" value="$(arg n_sensors)"/>
    <param name="record_tf" value="$(arg record_tf)"/>
    <param name="tf_reference_frame" value="$(arg tf_reference_frame)"/>
    <param name="experiment_id" value="$(arg experiment_id)"/>
    <param name="sensor_type" value="$(arg sensor_type)"/>
    <param name="board" value="$(arg board)"/>
    <param name="profile" value="$(arg profile)"/>
    <param name="mag_rate_hz" value="$(arg mag_rate_hz)"/>
    <param name="icm_rate_hz" value="$(arg icm_rate_hz)"/>
    <param name="coil_current_a" value="$(arg coil_current_a)"/>
    <param name="rotation_run_id" value="$(arg rotation_run_id)"/>
    <param name="firmware_status" value="$(arg firmware_status)"/>
    <param name="warning" value="$(arg warning)"/>
    <param name="ak_bitmap" value="$(arg ak_bitmap)"/>
    <param name="ak_count" value="$(arg ak_count)"/>
  </node>
</launch>
